NODE_ENV=development
API_PORT=4000
# Port fourni par la plateforme d'hébergement (Railway/Render). Prioritaire sur API_PORT.
# PORT=8080
DATABASE_URL=postgresql://freightmp:freightmp@localhost:5432/freightmp?schema=public
JWT_SECRET=change_me_super_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000
STEAM_API_KEY=your_steam_web_api_key
STEAM_RETURN_URL=http://localhost:4000/api/v1/auth/steam/callback
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_RETURN_URL=http://localhost:4000/api/v1/auth/discord/callback
INTERNAL_API_KEY=change_me_internal_secret
CORS_ORIGINS=http://localhost:3000

# Optional: Discord ID used by `prisma/seed.ts` to link the seeded ADMIN account.
# SEED_ADMIN_DISCORD_ID=
