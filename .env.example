# =====================================================================
# FreightMP (FMP) — fichier d'environnement racine (EXEMPLE)
# Copiez ce fichier vers `.env` puis renseignez VOS valeurs.
# ⚠️ Ne commitez JAMAIS le `.env` réel : il est ignoré par git.
# =====================================================================

# ---------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------
POSTGRES_USER=freightmp
POSTGRES_PASSWORD=change_me
POSTGRES_DB=freightmp
POSTGRES_PORT=5432

# ---------------------------------------------------------------------
# API (backend)
# ---------------------------------------------------------------------
API_PORT=4000
# Générée avec : openssl rand -hex 64
JWT_SECRET=change_me_generate_a_long_random_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000
# Générée avec : openssl rand -hex 32
INTERNAL_API_KEY=change_me_generate_a_random_key
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------
# Steam (OpenID + Web API)
#   Clé Web API : https://steamcommunity.com/dev/apikey
# ---------------------------------------------------------------------
STEAM_API_KEY=your_steam_web_api_key
STEAM_RETURN_URL=http://localhost:4000/api/v1/auth/steam/callback

# ---------------------------------------------------------------------
# Discord (OAuth2 + Bot)
#   Developer Portal : https://discord.com/developers/applications
#   DISCORD_CLIENT_ID  -> ID de l'application (OAuth2 + slash commands)
#   DISCORD_CLIENT_SECRET / DISCORD_BOT_TOKEN -> à régénérer, ne jamais exposer
# ---------------------------------------------------------------------
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_RETURN_URL=http://localhost:4000/api/v1/auth/discord/callback
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_guild_id

# ---------------------------------------------------------------------
# Synchronisation des rôles Discord (IDs des rôles de votre serveur)
# ---------------------------------------------------------------------
ROLE_ADMIN_ID=your_admin_role_id
ROLE_DEV_ID=your_dev_role_id
ROLE_MODERATOR_ID=your_moderator_role_id
ROLE_DRIVER_ID=your_driver_role_id
ROLE_SYNC_INTERVAL_MINUTES=15
REGISTER_COMMANDS=true
